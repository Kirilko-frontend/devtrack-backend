generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  companies           Company[]
  resumes             Resume[]
  vacancies           Vacancy[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  website   String?
  userId    Int
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies Vacancy[]

  @@map("companies")
}

model Vacancy {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?
  url              String?
  salary           String?
  status           VacancyStatus    @default(APPLIED)
  appliedAt        DateTime?
  userId           Int
  companyId        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  interviews       Interview[]
  resumes          Resume[]
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancyHistories VacancyHistory[]

  @@map("vacancies")
}

model Resume {
  id        Int      @id @default(autoincrement())
  name      String
  filePath  String
  userId    Int
  vacancyId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id])

  @@map("resumes")
}

model Interview {
  id        Int           @id @default(autoincrement())
  date      DateTime
  notes     String?
  types     InterviewType
  vacancyId Int
  vacancy   Vacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

model VacancyHistory {
  id        Int            @id @default(autoincrement())
  oldStatus VacancyStatus?
  newStatus VacancyStatus
  vacancyId Int
  changedAt DateTime       @default(now())
  vacancy   Vacancy        @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@map("vacancy_histories")
}

enum VacancyStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  SAVED
}

enum InterviewType {
  PHONE
  HR
  TECHNICAL
  FINAL
}
