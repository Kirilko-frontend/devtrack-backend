generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
  resumes   Resume[]
  vacancies Vacancy[]

  @@map("users")
}

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  website   String?
  userId    Int
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  vacancies Vacancy[]

  @@map("companies")
}

model Vacancy {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?
  url              String?
  salary           String?
  status           VacancyStatus    @default(SAVED)
  appliedAt        DateTime?
  userId           Int
  companyId        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  interviews       Interview[]
  resumes          Resume[]
  company          Company          @relation(fields: [companyId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  vacancyHistories VacancyHistory[]

  @@map("vacancies")
}

model Resume {
  id        Int      @id @default(autoincrement())
  name      String
  filePath  String
  userId    Int
  vacancyId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  vacancy   Vacancy? @relation(fields: [vacancyId], references: [id])

  @@map("resumes")
}

model Interview {
  id        Int           @id @default(autoincrement())
  date      DateTime
  notes     String?
  types     InterviewType
  vacancyId Int
  vacancy   Vacancy       @relation(fields: [vacancyId], references: [id])

  @@map("interviews")
}

model VacancyHistory {
  id        Int            @id @default(autoincrement())
  oldStatus VacancyStatus?
  newStatus VacancyStatus
  vacancyId Int
  changedAt DateTime       @default(now())
  vacancy   Vacancy        @relation(fields: [vacancyId], references: [id])

  @@map("vacancy_histories")
}

enum VacancyStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  SAVED
}

enum InterviewType {
  PHONE
  HR
  TECHNICAL
  FINAL
}
