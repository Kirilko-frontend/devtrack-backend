
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VacancyStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  SAVED
}

enum InterviewType {
  PHONE
  HR
  TECHNICAL
  FINAL
}


model User{
  id Int @id @default(autoincrement())

  email String @unique
  password String

  companies Company[]
  vacancies Vacancy[]
  resumes Resume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Company {
  id Int @id @default(autoincrement())

  name String
  website String?

  userId Int
  user User @relation(fields:[userId], references:[id])

  vacancies Vacancy[]

  createdAt DateTime @default(now())

  @@map("companies")
}

model Vacancy {
  id Int @id @default(autoincrement())

  title       String
  description String?
  url         String?
  salary      String?
  status      VacancyStatus @default(SAVED)
  appliedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  resumes Resume[]
  interviews Interview[]
  vacancyHistories VacancyHistory[]

  userId Int
  user User @relation(fields: [userId], references: [id])

  companyId Int
  company Company @relation(fields: [companyId], references: [id])

  @@map("vacancies")
}

model Resume {
  id Int @id @default(autoincrement())

  name String
  filePath String

  userId Int
  user User @relation(fields: [userId], references: [id])

  vacancyId Int?
  vacancy Vacancy? @relation(fields: [vacancyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

model Interview {
  id Int @id @default(autoincrement())

  date DateTime
  notes String?
  types InterviewType

  vacancyId Int
  vacancy Vacancy @relation(fields: [vacancyId], references: [id])

  @@map("interviews")
}


model VacancyHistory {
  id Int @id @default(autoincrement())

  oldStatus VacancyStatus?
  newStatus VacancyStatus

  vacancyId Int
  vacancy Vacancy @relation(fields: [vacancyId], references: [id])

  changedAt DateTime @default(now())

  @@map("vacancy_histories")
}